# server/.env 로 복사해서 사용한다. 실제 값은 커밋 금지.

# MySQL (docker-compose 기본값 기준)
DATABASE_URL=mysql+aiomysql://mongroo:mongroo@127.0.0.1:3306/mongroo

# 32바이트 이상 무작위 문자열로 교체할 것
JWT_SECRET=change-me-to-a-random-32byte-or-longer-secret

# disabled | fake | local
AI_MODE=fake

# Flutter web 로컬 개발 origin. JSON 배열 형식이며 "*"는 사용하지 않는다.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# AI_MODE=local일 때 사용
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b-q4_K_M
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=384
OLLAMA_TEMPERATURE=0.3
OLLAMA_TIMEOUT_SECONDS=60

# 파인튜닝된 감정 분류기 경로 (MONGROO_MODEL_ROOT 아래)
CLASSIFIER_MODEL_DIR=

# 학습 파이프라인용 (저장소 밖 경로)
# AIHUB_DATA_ROOT=D:\datasets\aihub
# MONGROO_MODEL_ROOT=D:\models\mongroo

# 이 파일은 예시다. 운영 값은 secret store에서 주입하고 커밋하지 않는다.
APP_ENV=production
DATA_PROFILE=real-data
DATABASE_URL=mysql+aiomysql://mongroo:replace-with-db-password@mysql:3306/mongroo
JWT_SECRET=replace-with-at-least-32-random-bytes
# `python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"`
# 로 생성하고 secret store에서 주입한다. 이전 키는 회전 완료 전까지 함께 둔다.
FIELD_ENCRYPTION_KEYS={"v1":"replace-with-base64-32-byte-key"}
ACTIVE_FIELD_ENCRYPTION_KEY_ID=v1
TERMS_VERSION=2026-08-05
PRIVACY_VERSION=2026-08-05
SENSITIVE_CONSENT_VERSION=2026-08-05
# Flutter Web의 약관·개인정보처리방침에 그대로 표시된다.
SERVICE_OPERATOR_NAME=replace-with-legal-operator-name
SERVICE_OPERATOR_ADDRESS=replace-with-operator-address
PRIVACY_CONTACT_EMAIL=privacy@example.com
DATA_HOSTING_DISCLOSURE=replace-with-provider-region-and-country
# GPU·외부 모델 없이 배포할 때는 rules. local은 Ollama·분류기 모델과
# local-ai 의존성을 포함한 별도 서버 이미지를 준비한 환경에서만 사용한다.
AI_MODE=rules
CORS_ORIGINS=["https://app.example.com"]
CORS_ORIGIN_REGEX=
ALLOWED_HOSTS=["app.example.com","api.example.com"]
MYSQL_DATABASE=mongroo
MYSQL_USER=mongroo
MYSQL_PASSWORD=replace-with-db-password
MYSQL_ROOT_PASSWORD=replace-with-root-password
MONGROO_ENV_FILE=.env.production
